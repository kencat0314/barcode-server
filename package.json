{
  "name": "barcode-server",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:win": "pkg . --targets node18-win-x64 --output dist/barcode-server.exe"
