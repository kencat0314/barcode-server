    "multer": "^1.4.5-lts.2",
    "mysql": "^2.18.1",
    "mysql2": "^3.14.3",
    "raw-body": "^3.0.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
